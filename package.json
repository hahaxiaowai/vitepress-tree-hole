{
  "name": "@night-tea/vitepress-tree-hole",
  "type": "module",
  "version": "0.16.0",
  "description": "A VitePress blog theme extracted into the local Turborepo workspace.",
  "homepage": "https://github.com/hahaxiaowai/blog_new/tree/main/packages/vitepress-tree-hole",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hahaxiaowai/blog_new.git",
    "directory": "packages/vitepress-tree-hole"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./baseConfig": {
      "types": "./dist/baseConfig.d.ts",
      "default": "./dist/baseConfig.js"
    },
    "./theme/*": "./theme/*",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "baseConfig.ts",
    "dist",
    "index.ts",
    "scripts",
    "theme"
  ],
  "scripts": {
    "build": "node scripts/copy.js && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "@night-tea/sakura-fall": "^0.1.0",
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "md-editor-v3": "^6.4.2",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "shadcn-vue": "^2.6.2",
    "typescript": "^6.0.3"
  }
}
